# =========================================================================
# SwingSocial Environment Variables Example Template
# Copy this file to .env.local and populate with your live credentials.
# =========================================================================

# Database Configuration
DB_USER=clark
DB_HOST=199.244.49.83
DB_NAME=swingsocialdb
DB_PASSWORD=Jaguar2020#
DB_PORT=5432

# AWS SDK Credentials (S3 & Face Verification)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=swingsocial-face-verification

# Payment Gateways (Stripe & PayPal)
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox # Use 'live' for production

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEMINI_API_KEY=your_gemini_api_key

# Image Moderation (SightEngine API)
NEXT_PUBLIC_SIGHTENGINE_API_USER=your_sightengine_api_user
NEXT_PUBLIC_SIGHTENGINE_API_SECRET=your_sightengine_api_secret

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Firebase Admin Credentials (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"

# Authorize.Net Credentials
AUTHORIZENET_API_LOGIN_ID=your_authorizenet_api_login_id
AUTHORIZENET_TRANSACTION_KEY=your_authorizenet_transaction_key
